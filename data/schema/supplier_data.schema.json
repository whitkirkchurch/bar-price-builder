{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whitkirk.com/bar/supplier_data.schema.json",
  "title": "Supplier Data Mapping",
  "description": "Maps supplier item codes to Loyverse PLUs and servings-per-unit factors.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "supplier_code": {
            "type": "integer",
            "minimum": 1
          },
          "comment": {
            "type": "string"
          },
          "ignore": {
            "type": "boolean"
          },
          "mapping": {
            "type": "object",
            "properties": {
              "plu": {
                "type": "integer",
                "minimum": 1
              },
              "servings_per_unit": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["plu", "servings_per_unit"],
            "additionalProperties": false
          }
        },
        "required": ["supplier_code"],
        "if": {
          "properties": {
            "ignore": {
              "const": true
            }
          },
          "required": ["ignore"]
        },
        "else": {
          "required": ["mapping"]
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["items"],
  "additionalProperties": false
}
